# https://sw.kovidgoyal.net/kitty/conf/
# Ctrl + Shift + F5 to reload

# Affects how "zoomed in" the terminal is
font_size 16.0

# font_family      family='JetBrainsMono Nerd Font' postscript_name=JetBrainsMonoNF-Regular
font_family      family='Iosevka'
bold_font        auto
italic_font      auto
bold_italic_font auto

# Emoji support 
symbol_map U+1F000-U+1FAFF Noto Color Emoji
symbol_map U+2600-U+27BF Noto Color Emoji

# No blinking
cursor_blink_interval 0

# Cool effect that can bee seen particularily when using
# vim or emacs motions
# cursor_trail 1

mouse_hide_wait 1.0

background #000000
foreground #DDDDDD

background_opacity 0.75

# cursor_trail 1
# cursor_trail_start_threshold 0

# Shaders
# Cursor
# custom_shaders cursor-trail-blaze
# custom_shaders cursor-trail-lightning

# Backgrounds
# custom_shaders inside-the-matrix
# custom_shaders northern-lights
# custom_shaders fireworks
# custom_shaders water

# Mouse-effects
# custom_shaders pond-ripple
# custom_shaders spotlight

# Navigation
# custom_shaders dim-inactive-windows
# custom_shaders tab-change
# custom_shaders focus-highlight 

# Terminals
# custom_shaders crt
# custom_shaders crt-blue
# custom_shaders tft

# Fixing tab stuff
tab_bar_style hidden
map ctrl+shift+space select_tab
